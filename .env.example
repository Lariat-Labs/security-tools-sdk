# Copy to .env and fill in what you have. Everything is optional:
# nvd, kev, epss, osint and feeds work with no configuration at all.

# --- SEC EDGAR (no key; contact info required by SEC fair-access policy) ---
SECSDK_SEC_USER_AGENT="Your Org security@your-org.example"

# --- NVD (optional; raises rate limit from 5 to 50 requests / 30s) ---
# NVD_API_KEY=

# --- Feedly ---
# FEEDLY_ACCESS_TOKEN=

# --- Tenable Vulnerability Management (read-only user recommended) ---
# TENABLE_ACCESS_KEY=
# TENABLE_SECRET_KEY=
# TENABLE_URL=https://cloud.tenable.com

# --- Azure (pick one; otherwise `az login` is used if the Azure CLI is installed) ---
# AZURE_ACCESS_TOKEN=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_IDS=["00000000-0000-0000-0000-000000000000"]
# SECSDK_AZURE_USE_CLI=true

# --- Core ---
# SECSDK_CACHE_ENABLED=true
# SECSDK_TIMEOUT=30
# SECCTL_FORMAT=json
