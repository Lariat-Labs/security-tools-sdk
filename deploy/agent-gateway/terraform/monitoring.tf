resource "azurerm_log_analytics_workspace" "this" {
  name                = "log-${var.prefix}-${local.suffix}"
  resource_group_name = azurerm_resource_group.this.name
  location            = var.location
  sku                 = "PerGB2018"
  retention_in_days   = 90
  tags                = var.tags
}

# Captured content (user input, tool arguments) is stored as span events in AppTraces:
# keep it 30 days. Spans (AppDependencies) keep the workspace default of 90.
resource "azurerm_log_analytics_workspace_table" "app_traces" {
  workspace_id            = azurerm_log_analytics_workspace.this.id
  name                    = "AppTraces"
  retention_in_days       = 30
  total_retention_in_days = 30
}

resource "azurerm_application_insights" "this" {
  name                = "appi-${var.prefix}-${local.suffix}"
  resource_group_name = azurerm_resource_group.this.name
  location            = var.location
  workspace_id        = azurerm_log_analytics_workspace.this.id
  application_type    = "web"
  tags                = var.tags
}

# Usage events (one per model call) for chargeback and the data lake.
resource "azurerm_eventhub_namespace" "this" {
  name                         = "evhns-${var.prefix}-${local.suffix}"
  resource_group_name          = azurerm_resource_group.this.name
  location                     = var.location
  sku                          = "Standard"
  capacity                     = 1
  local_authentication_enabled = false
  minimum_tls_version          = "1.2"
  tags                         = var.tags
}

resource "azurerm_eventhub" "usage" {
  name              = "agw-usage"
  namespace_id      = azurerm_eventhub_namespace.this.id
  partition_count   = 2
  message_retention = 7
}

resource "azurerm_role_assignment" "apim_sends_usage" {
  scope                = azurerm_eventhub.usage.id
  role_definition_name = local.role_eventhub_sender
  principal_id         = azurerm_user_assigned_identity.apim.principal_id
  principal_type       = "ServicePrincipal"
}

# Dashboards: Azure portal > Monitor > Workbooks. Generated by ../infra/workbooks/build.py.
locals {
  workbooks = {
    overview       = { name = "Agent gateway", file = "overview.json" }
    "run-explorer" = { name = "Agent gateway: run explorer", file = "run-explorer.json" }
    tools          = { name = "Agent gateway: tools", file = "tools.json" }
  }
}

resource "azurerm_application_insights_workbook" "dashboards" {
  for_each            = local.workbooks
  name                = uuidv5("url", "https://agent-gateway/${var.prefix}/workbook/${each.key}")
  resource_group_name = azurerm_resource_group.this.name
  location            = var.location
  display_name        = each.value.name
  category            = "workbook"
  source_id           = lower(azurerm_log_analytics_workspace.this.id)
  data_json = replace(
    jsonencode(merge(
      jsondecode(file("${path.module}/../infra/workbooks/${each.value.file}")),
      { fallbackResourceIds = [azurerm_log_analytics_workspace.this.id] },
    )),
    "__AGW_WORKSPACE_ID__",
    azurerm_log_analytics_workspace.this.id,
  )
  tags = var.tags
}
